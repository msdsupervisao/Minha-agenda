# Copie para .env.local. Não grave valores reais no Git.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=8000
APP_TIMEZONE=America/Cuiaba

NEXT_PUBLIC_SUPABASE_URL=
# Chave pública sb_publishable_...; pode aparecer no bundle e depende de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional e exclusivamente server-side. O app não precisa desta chave no fluxo comum.
SUPABASE_SECRET_KEY=

# Somente para o teste opt-in contra um projeto real. Nunca commitar valores.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=

# WhatsApp permanece desativado/mock nesta fase.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
