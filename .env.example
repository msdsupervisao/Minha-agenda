# Copie para .env.local. Não grave valores reais no Git.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=20000
# Piloto do novo núcleo agentic. Mantido desligado até a integração ser aprovada.
AGENT_V1_ENABLED=false
APP_TIMEZONE=America/Cuiaba

NEXT_PUBLIC_SUPABASE_URL=
# Chave pública sb_publishable_...; pode aparecer no bundle e depende de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side. Necessária apenas para o cron de lembretes ler dados entre usuários (bypassa RLS).
SUPABASE_SECRET_KEY=

# Notificações push (Web Push / VAPID). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com
# Segredo que protege POST /api/cron/reminders (envie no header x-cron-secret).
CRON_SECRET=

# Somente para o teste opt-in contra um projeto real. Nunca commitar valores.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=

# WhatsApp: mock por padrão. Ponha WHATSAPP_MODE=cloud + as 3 credenciais
# para ativar envio real (só janela de 24h; fora dela exige template).
WHATSAPP_MODE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
