NEXT_PUBLIC_SUPABASE_URL=cole_aqui_a_url_do_seu_projeto_supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=cole_aqui_a_chave_sb_publishable_do_supabase

# Opcional, apenas para futuras rotinas administrativas no backend.
# O fluxo autenticado atual usa a sessão do usuário + RLS e não usa esta chave.
SUPABASE_SECRET_KEY=

# Contas separadas usadas somente por `npm run test:supabase-live`.
SUPABASE_TEST_USER_A_EMAIL=
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=
SUPABASE_TEST_USER_B_PASSWORD=

# IA no backend: OmniRoute local, com Gemini explícito e fallback Groq explícito.
AI_PROVIDER=omniroute
OMNIROUTE_API_KEY=local
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_MODEL=gemini/gemini-3.1-flash-lite
OMNIROUTE_FALLBACK_MODEL=groq/openai/gpt-oss-20b
OMNIROUTE_FALLBACK_MODELS=groq/openai/gpt-oss-20b
OMNIROUTE_TIMEOUT_MS=60000
AI_LOCAL_FIRST=false
APP_TIMEZONE=America/Cuiaba

# Somente no backend/Edge Functions. Nunca use prefixo NEXT_PUBLIC_ em segredos.
# WHATSAPP_MODE=cloud ativa o envio real (senão fica em mock).
WHATSAPP_MODE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
