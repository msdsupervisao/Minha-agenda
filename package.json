{
  "name": "minha-agenda",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/system.mjs dev",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/system.mjs start",
    "start:background": "node scripts/system.mjs background",
    "stop": "node scripts/system.mjs stop",
    "health": "node scripts/system.mjs health",
    "setup:runtime": "node scripts/import-omniroute.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:openai-live": "tsx scripts/test-openai-live.ts",
    "test:supabase-live": "tsx scripts/test-supabase-live.ts",
    "test:agent-supabase-live": "node --env-file=.env.local --import tsx scripts/test-agent-supabase-live.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/three": "^0.185.4",
    "motion": "^13.1.0",
    "next": "^16.3.2",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
